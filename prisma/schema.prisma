generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  name     String
  role     String @default("user")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

model Faniya {
  id   String @id @default(cuid())
  name String @unique
  
  orders         Order[]
  payments       Payment[]
  monthlyReports MonthlyReport[]
  
  totalDebt      Float @default(0)
  totalPayments  Float @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("faniyas")
}

model Order {
  id String @id @default(cuid())
  
  faniyaId     String
  faniya       Faniya @relation(fields: [faniyaId], references: [id], onDelete: Cascade)
  
  orderDate    DateTime @default(now())
  customerName String
  
  length       Int
  skinType     String
  color        String
  highlights   String
  babyHairType String?
  openingTone  String?
  pattern      String
  notes        String?
  
  discount     Float @default(0)
  totalPrice   Float
  
  sentToTrass      Boolean @default(false)
  trassOperator    String?
  trassSentDate    DateTime?
  
  isCompleted      Boolean @default(false)
  deliveryDate     DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("orders")
}

model Payment {
  id String @id @default(cuid())
  
  faniyaId    String
  faniya      Faniya @relation(fields: [faniyaId], references: [id], onDelete: Cascade)
  
  totalAmount Float
  paymentDate DateTime @default(now())
  notes       String?
  
  paymentParts PaymentPart[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("payments")
}

model PaymentPart {
  id String @id @default(cuid())
  
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  amount      Float
  paymentType String
  
  checkNumber   String?
  checkDueDate  DateTime?
  bankReference String?
  notes         String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("payment_parts")
}

model PricingSettings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  skinType  String
  minLength Int?
  maxLength Int?
  price     Float
  
  @@index([skinType])
}

model MonthlyReport {
  id String @id @default(cuid())
  
  faniyaId String
  faniya   Faniya @relation(fields: [faniyaId], references: [id], onDelete: Cascade)
  
  year  Int
  month Int
  
  totalOrders    Int
  totalRevenue   Float
  totalPayments  Float
  monthlyDebt    Float
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([faniyaId, year, month])
  @@map("monthly_reports")
}