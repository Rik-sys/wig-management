generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// טבלת משתמשים
model User {
  id       String @id @default(cuid())
  username String @unique
  password String
  name     String
  role     String @default("user") // "admin" או "user"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("users")
}

// טבלת פאניות
model Faniya {
  id   String @id @default(cuid())
  name String @unique
  
  // קשרים
  orders         Order[]
  payments       Payment[]
  monthlyReports MonthlyReport[] // הוספתי את הקשר הזה שהיה חסר!
  
  // חישובים
  totalDebt    Float @default(0)
  totalPayments Float @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("faniyas")
}

// טבלת הזמנות
model Order {
  id String @id @default(cuid())
  
  // פרטי הזמנה בסיסיים
  faniyaId     String
  faniya       Faniya @relation(fields: [faniyaId], references: [id], onDelete: Cascade)
  
  orderDate    DateTime @default(now())
  customerName String
  
  // מפרטי הפאה
  length       Int // אורך בס"מ
  skinType     String // "רגיל" או "מאוורר"  
  color        String
  highlights   String // "עדינים" / "ללא גוונים" / "בולטים" / "אחר"
  babyHairType String?
  openingTone  String?
  pattern      String // "ייבוש טבעי תנועה גדולה" / "תלתלים" / "חלק גמיש" / "אחר"
  notes        String?
  
  // מחיר והנחות
  discount     Float @default(0)
  totalPrice   Float // מחושב: length * skinTypeMultiplier - discount
  
  // טרסים
  sentToTrass      Boolean @default(false)
  trassOperator    String? // "לאופר" או "שורי"
  trassSentDate    DateTime?
  
  // סטטוס ומסירה
  isCompleted      Boolean @default(false)
  deliveryDate     DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("orders")
}

// טבלת תשלומים - עודכן לתמיכה בתשלומים מורכבים
model Payment {
  id String @id @default(cuid())
  
  faniyaId    String
  faniya      Faniya @relation(fields: [faniyaId], references: [id], onDelete: Cascade)
  
  totalAmount Float // סכום כולל של התשלום
  paymentDate DateTime @default(now())
  notes       String?
  
  // חלקי התשלום
  paymentParts PaymentPart[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("payments")
}

// טבלת חלקי תשלום - כל חלק הוא סוג תשלום אחד
model PaymentPart {
  id String @id @default(cuid())
  
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  
  amount      Float
  paymentType String // "מזומן" / "צ'ק" / "העברה בנקאית"
  
  // פרטים נוספים לפי סוג התשלום
  checkNumber   String?   // מספר צ'ק
  checkDueDate  DateTime? // תאריך פרעון צ'ק
  bankReference String?   // מספר העברה/אסמכתא
  notes         String?   // הערות לחלק הזה
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("payment_parts")
}

// טבלת הגדרות מחירים
model PricingSettings {
  id String @id @default(cuid())
  
  skinType   String @unique // "רגיל" או "מאוורר"
  pricePerCm Float // מחיר לס"מ
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("pricing_settings")
}

// טבלת דוחות חודשיים (אופציונלי - לאופטימיזציה)
model MonthlyReport {
  id String @id @default(cuid())
  
  faniyaId String
  faniya   Faniya @relation(fields: [faniyaId], references: [id], onDelete: Cascade)
  
  year  Int
  month Int // 1-12
  
  totalOrders    Int
  totalRevenue   Float
  totalPayments  Float
  monthlyDebt    Float
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([faniyaId, year, month])
  @@map("monthly_reports")
}